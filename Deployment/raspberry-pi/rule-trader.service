[Unit]
Description=PyTrading internal paper observer (no brokerage orders)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
# 아래 사용자와 경로는 배포 예시다. 실기기 확인 후 변경한다.
User=trader
WorkingDirectory=/opt/PyTrading
Environment=PYTHONUTF8=1
Environment=PYTRADING_PROFILE=earnings
Environment=PYTRADING_SETTINGS=/opt/PyTrading/Config/settings-linux.json
ExecStart=/bin/sh /opt/PyTrading/Deployment/raspberry-pi/start.sh
Restart=on-failure
RestartSec=20
TimeoutStartSec=180
TimeoutStopSec=40
WatchdogSec=180
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/PyTrading/Data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
